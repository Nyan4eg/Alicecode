{
  "name": "alicecode",
  "productName": "Alicecode",
  "version": "0.5.1",
  "private": true,
  "description": "A Windows coding workspace powered by Alice AI LLM and Grok Build.",
  "author": "Nyan4eg",
  "license": "MIT",
  "repository": "https://github.com/Nyan4eg/Alicecode",
  "main": "app/main.mjs",
  "scripts": {
    "build:ui": "esbuild app/ui/editor.mjs --bundle --minify --outfile=app/ui/editor.bundle.js",
    "prestart": "npm run build:ui",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "predist:win": "npm run build:ui",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "electron-updater": "6.8.11"
  }
}
